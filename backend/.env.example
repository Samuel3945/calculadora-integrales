# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
# Wall-clock budget (seconds) for the exact symbolic integral / singularity check.
SYMBOLIC_TIMEOUT_SECONDS=5
# Where the symbolic job runs: auto (thread when the VERCEL env var is set, else process),
# process (killable child process) or thread (in-process pool; cannot kill a stuck job).
SYMBOLIC_MODE=auto
