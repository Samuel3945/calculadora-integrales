  },
  "dependencies": {
    "@tanstack/react-query": "5.108.0",
    "axios": "1.21.1",
    "katex": "0.19.1",
    "mathlive": "0.111.4",
    "plotly.js-basic-dist-min": "4.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/katex": "0.16.8",
    "@types/node": "26.6.6",
    "@types/plotly.js": "3.0.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
