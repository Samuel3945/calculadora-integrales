# Base URL of the backend API, including the /api/v1 prefix.
# Development default (see .env.development): http://localhost:8000/api/v1
# When unset in a production build the app falls back to the relative path /api/v1
# (same-domain deployment, e.g. Vercel serving FastAPI under the same host).
VITE_API_BASE_URL=http://localhost:8000/api/v1
